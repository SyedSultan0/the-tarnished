# ------------------------------------------------------------------
# THE TARNISHED backend — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# TWILIO WHATSAPP CONFIGURATION (required for the WhatsApp pipeline)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_SANDBOX_CODE=join twilio-trial

# Public base URL used to build audio URLs for WhatsApp.
# In production this must be the publicly reachable backend URL.
# Example: https://crop-advisory.example.com
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------
# TTS CONFIGURATION (optional; the project uses free gTTS by default)
# ------------------------------------------------------------------
# TTS_API_KEY=
# TTS_VOICE=te-IN

# ------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Comma-separated allowed CORS origins for the web frontend.
# Leave empty to use the localhost development defaults.
# Production example:  CORS_ALLOW_ORIGINS=https://crop-advisory.example.com
CORS_ALLOW_ORIGINS=